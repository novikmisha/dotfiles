#zmodload zsh/zprof

# nvim as default editor
export EDITOR='nvim'

# don't show company info in claude
export IS_DEMO=1
# multiple cli's doesn't send metrics if this flag is enabled
export DO_NOT_TRACK=1
# disable oh-my-zsh auto update
export DISABLE_AUTO_UPDATE=true

# add completions
typeset -U fpath
fpath=(
    /opt/homebrew/share/zsh/site-functions
    /opt/homebrew/opt/curl/share/zsh/site-functions
    "$HOME/.docker/completions"
    "$HOME/.oh-my-zsh/custom/completions"
    $fpath
)

export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="my"

zstyle ':omz:plugins:nvm' lazy yes
zstyle ':omz:plugins:nvm' autoload yes

plugins=(cmdtime git nvm sdkman-lazy)

source $ZSH/oh-my-zsh.sh
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh


alias personal="cd $HOME/vaults/personal && nvim index.md"
alias work="cd $HOME/vaults/work && nvim index.md"

alias prod='tsh proxy kube prod-k8s-app01 --exec-cmd sofka'
alias dev='tsh proxy kube dev-k8s-app01 --exec-cmd sofka'



alias n="nvim"
alias vi="nvim"
alias vim="nvim"
alias view="nvim -R"
alias vimdiff="nvim -d"

path=(
    "$HOME/work_projects/nstack/bin"
    /opt/homebrew/opt/libpq/bin
    "$HOME/go/bin"
    /opt/homebrew/opt/curl/bin
    "${path[@]}"
)



# shortcut: refresh the cached Worktrunk init after Worktrunk upgrades.
[[ -r "$HOME/.cache/worktrunk-init.zsh" ]] && source "$HOME/.cache/worktrunk-init.zsh"

#zprof
